{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Relay": {
    "PollIntervalMs": 5000,
    "BatchSize": 100,
    "MaxRetryCount": 3
  },
  "RateLimiter": {
    "MaxRequests": 100,
    "WindowSeconds": 60
  },
  "Maintenance": {
    "IntervalMinutes": 5
  }
}