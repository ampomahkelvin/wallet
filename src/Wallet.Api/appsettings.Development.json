{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=wallet;Username=wallet;Password=wallet",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Redis": "localhost:6379"
  },
  "Relay": {
    "PollIntervalMs": 5000,
    "BatchSize": 100,
    "MaxRetryCount": 3
  },
  "RateLimiter": {
    "MaxRequests": 100,
    "WindowSeconds": 60
  },
  "Maintenance": {
    "IntervalMinutes": 5
  }
}